# ==============================================================================
# Playwright E2E Test Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Active Environment Switch:
# Set to 'local' for local testing (http://localhost:5173)
# Set to 'dev' for remote/dev environment testing
TEST_ENV=local

# ------------------------------------------------------------------------------
# Direct URL Overrides (Optional)
# ------------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL=
# PLAYWRIGHT_API_URL=

# ------------------------------------------------------------------------------
# LOCAL Environment Settings
# ------------------------------------------------------------------------------
LOCAL_BASE_URL=http://localhost:5173
LOCAL_API_URL=http://localhost:5000/api
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/panaceainfosec

LOCAL_ADMIN_EMAIL=panacea@yopmail.com
LOCAL_ADMIN_PASSWORD=guru@1234

LOCAL_CUSTOMER_EMAIL=customer@panaceatest.com
LOCAL_CUSTOMER_PASSWORD=Password@123

LOCAL_QSA_EMAIL=qsa@panaceatest.com
LOCAL_QSA_PASSWORD=Password@123

LOCAL_QA_EMAIL=qa@panaceatest.com
LOCAL_QA_PASSWORD=Password@123

LOCAL_CONSULTANT_EMAIL=consultant@panaceatest.com
LOCAL_CONSULTANT_PASSWORD=Password@123

# ------------------------------------------------------------------------------
# DEV Environment Settings
# ------------------------------------------------------------------------------
DEV_BASE_URL=https://dev.panaceainfosec.com
DEV_API_URL=https://dev.panaceainfosec.com/api
DEV_MONGODB_URI=

DEV_ADMIN_EMAIL=panacea@yopmail.com
DEV_ADMIN_PASSWORD=guru@1234

DEV_CUSTOMER_EMAIL=customer@panaceatest.com
DEV_CUSTOMER_PASSWORD=Password@123

DEV_QSA_EMAIL=qsa@panaceatest.com
DEV_QSA_PASSWORD=Password@123

DEV_QA_EMAIL=qa@panaceatest.com
DEV_QA_PASSWORD=Password@123

DEV_CONSULTANT_EMAIL=consultant@panaceatest.com
DEV_CONSULTANT_PASSWORD=Password@123

# ------------------------------------------------------------------------------
# Test Runner & Browser Configuration
# ------------------------------------------------------------------------------
HEADLESS=true
BROWSER_CHANNEL=chrome
DEFAULT_TEST_PASSWORD=Password@123
